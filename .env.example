YOWAYOWA_MODE=personal
YOWAYOWA_DATABASE_URL=sqlite:///./data/yowayowa.db
# SEC requests must identify the application and a real contact address.
YOWAYOWA_SEC_USER_AGENT=Yowayowa-Investor/0.1 your-email@example.com
YOWAYOWA_SEC_REQUESTS_PER_SECOND=8

# Official / registered data-provider access.
# BLS works without a key at lower limits; a free registered key raises API limits.
YOWAYOWA_BLS_API_KEY=
# BEA NIPA data is public-domain government data, but API access uses a free registered key.
YOWAYOWA_BEA_API_KEY=
# Japan e-Stat official statistics require a free registered application ID.
YOWAYOWA_ESTAT_APP_ID=
# EDINET requires registered API access; covered content is handled under PDL1.0/site terms.
YOWAYOWA_EDINET_API_KEY=
# Daily maintenance fills a shared recent EDINET filing index newest-first.
YOWAYOWA_EDINET_INDEX_LOOKBACK_DAYS=550
YOWAYOWA_EDINET_INDEX_BACKFILL_DAYS_PER_RUN=31
# Generic FRED remains personal/BYOK because underlying series rights vary by source.
YOWAYOWA_FRED_API_KEY=

# Personal-only enrichment boundary. Public mode rejects true at startup.
YOWAYOWA_LOCAL_ENRICHMENT_ENABLED=false

# Optional OpenAI-compatible BYOK planner
YOWAYOWA_OPENAI_COMPATIBLE_BASE_URL=
YOWAYOWA_OPENAI_COMPATIBLE_API_KEY=
YOWAYOWA_OPENAI_COMPATIBLE_MODEL=

# Required when YOWAYOWA_MODE=public. Private workspace/API routes still require this token.
YOWAYOWA_API_TOKEN=

# Full/Operator mode (personal mode only). Public mode forces these capabilities off.
YOWAYOWA_PRIVATE_CONNECTORS_ENABLED=true
YOWAYOWA_SCRAPING_ENABLED=true
YOWAYOWA_BROKER_CONTROL_ENABLED=true
# Live submission is deliberately a separate arm switch. Read-only broker control can stay enabled.
YOWAYOWA_BROKER_LIVE_ORDERS_ENABLED=false
YOWAYOWA_BROKER_RISK_CURRENCY=JPY
# Required before enabling live orders.
# YOWAYOWA_BROKER_MAX_SINGLE_ORDER_NOTIONAL=500000
# YOWAYOWA_BROKER_MAX_ORDERS_PER_DAY=20

# Authorized private mailbox sources (personal mode only). The operator's own
# subscribed notification mail (e.g. broker earnings-calendar alerts) is read
# through the read-only `gog` CLI (always invoked with --readonly).
YOWAYOWA_MAILBOX_COMMAND=gog
# Optional: local file holding the gog keyring password. Only the path is
# configured - never paste the password itself into this file. The value is
# never logged or returned by the API/CLI. If the environment already sets
# GOG_KEYRING_PASSWORD, that value takes precedence over this file.
YOWAYOWA_MAILBOX_KEYRING_PASSWORD_FILE=
